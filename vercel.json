{
  "framework": null,
  "buildCommand": "npm run build:release",
  "installCommand": "echo Static site - no dependencies needed",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(editorial|work|clients|identity|brand)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/index_con_logo.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index_con_logo",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/automatizar-facturacion-electronica-colombia/:rest*",
      "destination": "/blog/facturacion-electronica-automatica-colombia/",
      "permanent": true
    },
    {
      "source": "/blog/automatizar-facturacion-electronica-colombia/",
      "destination": "/blog/facturacion-electronica-automatica-colombia/",
      "permanent": true
    },
    {
      "source": "/blog/tres-errores-que-estan-impidiendo-a-colombia/:rest*",
      "destination": "/blog/errores-al-comprar-software-a-la-medida/",
      "permanent": true
    },
    {
      "source": "/blog/tres-errores-que-estan-impidiendo-a-colombia/",
      "destination": "/blog/errores-al-comprar-software-a-la-medida/",
      "permanent": true
    },
    {
      "source": "/blog/google-cloud-impulsa-la-ia-agentica-colombia/:rest*",
      "destination": "/blog/inteligencia-artificial-negocios-colombia/",
      "permanent": true
    },
    {
      "source": "/blog/google-cloud-impulsa-la-ia-agentica-colombia/",
      "destination": "/blog/inteligencia-artificial-negocios-colombia/",
      "permanent": true
    },
    {
      "source": "/sitemap-seo.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ]
}
